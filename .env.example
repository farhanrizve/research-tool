# ── Research Tool — Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in your API keys.
#
#   cp .env.example .env
#
# Only the keys you need should be uncommented. All have sensible defaults.

# ── OpenCode Zen (FREE models — recommended to start) ──────────────────────────
# Get your key at https://opencode.ai/zen
RESEARCH_ZEN_API_KEY=

# ── LLM Provider (optional — used if not using Zen) ───────────────────────────
# RESEARCH_LLM_PROVIDER=openai
# RESEARCH_LLM_MODEL=gpt-4o-mini
# RESEARCH_LLM_API_KEY=
# RESEARCH_LLM_BASE_URL=

# ── Search APIs (optional — enables web search) ────────────────────────────────
# RESEARCH_TAVILY_API_KEY=
# RESEARCH_SEMANTIC_SCHOLAR_API_KEY=

# ── Defaults (optional) ────────────────────────────────────────────────────────
# RESEARCH_DEFAULT_DEPTH=standard
# RESEARCH_DEFAULT_SOURCES=["semantic_scholar", "arxiv", "web"]
# RESEARCH_MAX_CONCURRENT_AGENTS=5
